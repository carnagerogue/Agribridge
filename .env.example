# Local development. Copy this example into your own ignored environment file.
# Never commit real values. Never prefix a server secret with VITE_.
NODE_ENV=development
AGRIBRIDGE_DEMO=false
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://localhost:5180
DATABASE_PATH=.data/agribridge
DATABASE_URL=
DATABASE_TLS=false
# Optional PEM contents for a private database certificate authority.
DATABASE_CA_CERT=
# auto applies schema migrations at startup. verify refuses to start until
# `npm run db:migrate` has applied them with schema-change credentials.
DATABASE_MIGRATIONS=auto
TRUST_PROXY=0

# Optional integrations; empty means unavailable, never simulated delivery.
# Set WEATHER_PROVIDER=met-no for the public MET Norway Locationforecast
# (CC BY 4.0 attribution, identifying User-Agent, cached server-side).
WEATHER_PROVIDER=
# Alternative forecasts: required in production unless WEATHER_PROVIDER=met-no
# (the free public Open-Meteo API
# is noncommercial). Use https://customer-api.open-meteo.com/v1/forecast with an
# API key, or your own self-hosted Open-Meteo server. Development falls back to
# the public API.
OPEN_METEO_BASE_URL=
OPEN_METEO_API_KEY=
OPENAI_API_KEY=
AI_DAILY_REQUEST_LIMIT=100
AI_USER_DAILY_REQUEST_LIMIT=10
MESSAGING_DAILY_LIMIT=200
MESSAGING_TENANT_DAILY_LIMIT=100
MESSAGING_RECIPIENT_DAILY_LIMIT=5
CHANNEL_ORGANIZATION_ID=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_ENVIRONMENT=
AT_WEBHOOK_SECRET=
AT_USSD_SERVICE_CODE=
SMS_MAX_SEGMENTS=3
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Public E.164 support number, e.g. +256 followed by the registered mobile number.
# This is NOT WHATSAPP_PHONE_NUMBER_ID. Exposed only to the configured organization.
WHATSAPP_BUSINESS_NUMBER=
# Market conversation workers are opt-in. Existing WhatsApp configuration and
# CHANNEL_ORGANIZATION_ID are required; demo mode never sends real messages.
MARKET_WHATSAPP_ENABLED=false
# Set true only after native-speaker review of the prepared Luganda text path.
# This does not activate voice recognition or spoken replies.
MARKET_LUGANDA_REVIEWED=false
MARKET_PAYMENT_NOTIFICATIONS_ENABLED=false
# Optional trusted payment translation gateway, not a ready-made provider adapter.
# Clients pay sellers directly; choose/configure the real provider before enabling.
MARKET_PAYMENT_EVENTS_ENABLED=false
MARKET_PAYMENT_PROVIDER=
MARKET_PAYMENT_WEBHOOK_SECRET=
MARKET_PAYMENT_TEMPLATE_APPROVED_EN=
MARKET_PAYMENT_TEMPLATE_CONFIRMED_EN=
MARKET_PAYMENT_TEMPLATE_FAILED_EN=
MARKET_PAYMENT_TEMPLATE_REFUNDED_EN=
MARKET_PAYMENT_TEMPLATE_APPROVED_LG=
MARKET_PAYMENT_TEMPLATE_CONFIRMED_LG=
MARKET_PAYMENT_TEMPLATE_FAILED_LG=
MARKET_PAYMENT_TEMPLATE_REFUNDED_LG=
# WhatsApp inbox/reply bodies expire after 30 days. Metadata and provider records
# have separate operational retention; never put private message text into logs.

# Docker Compose production deployment: use a SEPARATE ignored deployment env file.
# Set PUBLIC_ORIGIN to HTTPS and DATABASE_URL to the agribridge_app account.
# The database TLS certificate must include DNS SAN db; public CA file must be readable
# by container UID 1000. Password files and server private key remain private.
AGRIBRIDGE_IMAGE_TAG=local
POSTGRES_ADMIN_PASSWORD_FILE=
POSTGRES_APP_PASSWORD_FILE=
POSTGRES_TLS_CERT_FILE=
POSTGRES_TLS_KEY_FILE=
POSTGRES_CA_FILE=

# One-time administrator provisioning only. Remove values after bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ORGANIZATION_NAME=
