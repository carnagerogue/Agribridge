{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "rootDir": "server",
    "outDir": "dist-server",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["server/**/*.ts"],
  "exclude": ["server/**/*.test.ts", "server/tests/**"]
}
