{
  "name": "agribridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:api:watch\" \"npm:web\"",
    "demo": "cross-env AGRIBRIDGE_DEMO=true npm run dev",
    "web": "vite --host 127.0.0.1",
    "api": "tsx server/index.ts",
    "api:watch": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "admin:create:production": "node dist-server/bootstrap-admin.js",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && npm run test:server",
    "test:server": "tsx --test server/tests/*.test.ts server/channels/*.test.ts server/ai/*.test.ts",
    "admin:create": "tsx server/bootstrap-admin.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  }
}
